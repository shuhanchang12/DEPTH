# Gemini Prediction Markets API
# Sandbox by default — do not point at production with live keys for MVP testing
GEMINI_BASE_URL=https://api.sandbox.gemini.com
GEMINI_API_KEY=
GEMINI_API_SECRET=
# incremental = ms timestamps (strictly increasing); time-based = unix seconds
GEMINI_NONCE_MODE=incremental

# Arc Testnet
ARC_RPC=https://rpc.testnet.arc.network
USDC_ADDRESS=0x3600000000000000000000000000000000000000
VAULT_ADDRESS=
OPERATOR_PRIVATE_KEY=

# Quoting defaults (fixed spread, size caps, two-sided maker-or-cancel)
QUOTE_SIZE=50
MAX_QUOTE_SIZE=100
QUOTE_SPREAD=0.04
QUOTE_OUTCOME=yes
REFRESH_SECONDS=60
# true = log intended place/cancel payloads without calling private endpoints
DRY_RUN=true
