# Gemini Prediction Markets
# Orders go to the sandbox. Public data (reward pools, books) is read from production.
GEMINI_BASE_URL=https://api.sandbox.gemini.com
GEMINI_PUBLIC_URL=https://api.gemini.com
GEMINI_API_KEY=
GEMINI_API_SECRET=
# incremental = ms timestamps (strictly increasing); time-based = unix seconds
GEMINI_NONCE_MODE=incremental

# Arc Testnet
ARC_RPC=https://rpc.testnet.arc.network
USDC_ADDRESS=0x3600000000000000000000000000000000000000
VAULT_ADDRESS=
OPERATOR_PRIVATE_KEY=

# Allocation
CAPITAL_USDC=1000
MAX_MARKETS=5
MIN_MINUTES_LEFT=30

# Quoting (maker-or-cancel, two-sided)
QUOTE_SIZE=100
MAX_QUOTE_SIZE=200
QUOTE_SPREAD=0.04
QUOTE_STYLE=yes_no
REFRESH_SECONDS=60
# true = print orders without calling private endpoints
DRY_RUN=true
